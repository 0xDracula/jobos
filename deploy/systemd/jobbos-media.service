[Unit]
Description=Jobbos media service
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=/srv/jobbos/services/media
EnvironmentFile=/srv/jobbos/.env
Environment=PATH=/srv/jobbos/services/media/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/jobbos/services/media/.venv/bin/uvicorn jobbos_media.app:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
